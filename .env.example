# News Pilot — Environment Configuration

# Required: OpenAI (news translation)
OPENAI_API_KEY=sk-...

# Required: ElevenLabs — listening (radio bulletin audio) is available in English and Hindi.
ELEVENLABS_API_KEY=sk-...
# US female voice used for English radio bulletins (defaults to Rachel: 21m00Tcm4TlvDq8ikWAM)
# ELEVENLABS_VOICE_ID_EN=21m00Tcm4TlvDq8ikWAM
# Voice used for Hindi radio bulletins (defaults to ELEVENLABS_VOICE_ID; use a multilingual-capable voice)
# ELEVENLABS_VOICE_ID_HI=21m00Tcm4TlvDq8ikWAM

# News Pilot — Environment Configuration

# Required: OpenAI (news translation)
OPENAI_API_KEY=sk-...

# Required: ElevenLabs — used for English, Hindi, Maithili, and any other
# language without a Bhashini voice.
ELEVENLABS_API_KEY=sk-...
# US female voice used for English radio bulletins (defaults to Rachel: 21m00Tcm4TlvDq8ikWAM)
# ELEVENLABS_VOICE_ID_EN=21m00Tcm4TlvDq8ikWAM

# Optional: Bhashini (government TTS) — native voices for low-resource
# languages ElevenLabs doesn't cover well.
# BHASHINI_API_KEY=
